{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The bench runs core, the extension's fetching and the renderer's pure parts in one process, so it
    // checks them with the union of their settings: Node's types, the browser's, the extension APIs'
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "chrome"],
    "paths": { "@/*": ["../../app/src/*"] }
  },
  "include": ["src", "vitest.config.ts"]
}
