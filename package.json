{
  "name": "owlit",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @owlit/desktop dev",
    "dev:web": "pnpm --filter owlit-app dev",
    "try": "node scripts/try.mjs",
    "build": "pnpm --filter @owlit/desktop build",
    "test": "vitest run",
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm -r typecheck",
    "i18n:extract": "lingui extract --clean",
    "app:install": "node apps/desktop/scripts/install-app.mjs",
    "release": "pnpm --filter @owlit/desktop release",
    "release:ship": "node apps/desktop/scripts/ship.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@lingui/cli": "6.9.1",
    "@lingui/conf": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/native-tools": "0.1.6",
    "vitest": "5.0.2"
  }
}
