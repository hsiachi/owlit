{
  "name": "@owlit/share-worker",
  "private": true,
  "version": "0.0.0",
  "description": "The share server on Cloudflare: a Worker, a Durable Object per shared doc, and the reader's page",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @owlit/share-web build && wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "types": "wrangler types",
    "lint": "oxlint",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit"
  },
  "dependencies": {
    "@owlit/protocol": "workspace:*",
    "@owlit/share-server": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  }
}
